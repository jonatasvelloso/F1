# Copie para .env e ajuste conforme necessário. Nenhum valor aqui é secreto.
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # default: DEBUG em development, INFO nos demais

OPENF1_BASE_URL=https://api.openf1.org/v1
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=3

DEFAULT_YEAR=2024
TOP_N_LAPS=5
CACHE_TTL_SECONDS=3600
